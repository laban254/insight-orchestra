# Insight Orchestra Configuration.
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Configuration (Required)
# ============================================================================

# ── Choose your LLM provider ──────────────────────────────────
LLM_PROVIDER=openai          # openai | anthropic | ollama

# ── OpenAI (cloud) ────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FALLBACK=gpt-4o

# ── Anthropic (cloud) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Ollama (local — zero data leaves your machine) ────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ============================================================================
# Application Settings
# ============================================================================

# Backend host (default: 0.0.0.0 for all interfaces)
BACKEND_HOST=0.0.0.0

# Backend port (default: 8000)
BACKEND_PORT=8000

# Backend URL for frontend (used by Streamlit)
BACKEND_URL=http://localhost:8000

# Frontend port (default: 8501)
FRONTEND_PORT=8501

# Application environment (development/production)
ENVIRONMENT=development

# Enable/disable demo endpoints (disable in production)
DEMO_MODE=true

# ============================================================================
# Redis Configuration (for session storage)
# ============================================================================

# Redis URL (set to redis://host:port or redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Enable/disable Redis (set to false to use in-memory fallback)
USE_REDIS=true

# Session TTL in seconds (default: 3600 = 1 hour)
SESSION_TTL_SECONDS=3600

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Allowed origins for CORS (comma-separated in production)
CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN_ALT=http://localhost:8501

# ============================================================================
# File Upload Settings
# ============================================================================

# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# Upload directory (relative to project root)
UPLOAD_DIR=backend/uploads

# ============================================================================
# BigQuery (Optional)
# ============================================================================

# If using BigQuery integration, add credentials via API endpoint
# See: POST /bigquery endpoint in FastAPI

# ============================================================================
# Logging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# Sandbox Settings (for code execution)
# ============================================================================

# Enable/disable sandboxed code execution (recommended: true)
SANDBOX_ENABLED=true

# Maximum execution time in seconds
SANDBOX_TIMEOUT=30

# Maximum memory in MB
SANDBOX_MEMORY_LIMIT=256
