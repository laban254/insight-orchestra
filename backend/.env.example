# Insight Orchestra Configuration.
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Configuration (Required)
# ============================================================================

# ── Choose your LLM provider ──────────────────────────────────
LLM_PROVIDER=openai          # openai | anthropic | deepseek | ollama

# ── OpenAI (cloud) ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FALLBACK=gpt-4o

# ── Anthropic (cloud) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── DeepSeek (cloud — OpenAI-compatible, fast & cheap) ────────
DEEPSEEK_API_KEY=sk-...      # get one at https://platform.deepseek.com
DEEPSEEK_MODEL=deepseek-chat # or deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Ollama (local — zero data leaves your machine) ────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ============================================================================
# Application Settings
# ============================================================================

# Backend host (default: 0.0.0.0 for all interfaces)
BACKEND_HOST=0.0.0.0

# Backend port (default: 8000)
BACKEND_PORT=8000

# Frontend port (default: 8501)
FRONTEND_PORT=8501

# Application environment (development/production)
ENVIRONMENT=production

# ============================================================================
# Auth (Optional) — off by default; single-tenant/no-login unless enabled
# ============================================================================

# Turn on login + role-based access control (admin/member/viewer). Leave
# false for local/single-user use — that's the vast majority of deployments.
AUTH_ENABLED=false

# Bootstrap the first account (role: admin) on startup, if no users exist
# yet. Leave both unset for an OIDC-only setup — the first person to sign in
# via SSO becomes admin instead. Only takes effect when AUTH_ENABLED=true.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# SSO via OpenID Connect (SAML not supported). All four required together.
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback

# ============================================================================
# CORS — set to your actual domain(s) in production
# ============================================================================
# Comma-separated list of allowed origins. No trailing slash.
# Example: https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# ============================================================================
# File Upload Settings
# ============================================================================

# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# Upload directory (relative to project root)
UPLOAD_DIR=backend/uploads

# ============================================================================
# BigQuery (Optional)
# ============================================================================

# If using BigQuery integration, add credentials via API endpoint
# See: POST /bigquery endpoint in FastAPI

# ============================================================================
# Logging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# Sandbox Settings (for code execution)
# ============================================================================

# Enable/disable sandboxed code execution (recommended: true)
SANDBOX_ENABLED=true

# Maximum execution time in seconds
SANDBOX_TIMEOUT=30

# Maximum memory in MB
SANDBOX_MEMORY_LIMIT=256

# LLM request timeout in seconds
REQUEST_TIMEOUT=600
MAX_RETRIES=1
